// kmp-product-flavors — flavor: demo  build-type: debug
// Generated pattern: Configs/{variant}.xcconfig — edit to override flavor values.
// Run `./gradlew :cmp-shared:kmpFlavorsGenerateXcconfigs` to regenerate from Gradle DSL.

KMPF_VARIANT = demoDebug
KMPF_FLAVOR_NAME = demo
KMPF_BUILD_TYPE_NAME = debug
KMPF_BASE_URL = https://demo.openmf.org
KMPF_BUNDLE_ID = cmp-shared.demo
KMPF_DEMO_USERNAME = demo
KMPF_DEMO_PASSWORD = demo
KMPF_ENABLE_LOGGING = YES
KMPF_IS_DEBUG = YES
KMPF_IS_DEMO = YES
KMPF_IS_DEMO_BUILD = YES
KMPF_LOG_TAG = KMPTemplate-DEBUG
KMPF_SHOW_DEBUG_OVERLAY = YES

