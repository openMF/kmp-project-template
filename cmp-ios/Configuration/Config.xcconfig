// Fork identity — generated by ./gradlew syncForkConfig
// To change: edit gradle/fork.properties (or libs.versions.toml for app.id),
// then re-run ./gradlew syncForkConfig
//
// SIGNING STRATEGY:
//   Debug:   CODE_SIGN_STYLE = Automatic — Xcode uses the developer's own Apple ID.
//            Any contributor (including free Apple ID) can build + run without setup.
//   Release: CODE_SIGN_STYLE = Manual — Match-managed via openMF/ios-provisioning-profile.
//            Requires MATCH_PASSWORD + repo access (admins / CI only).
//
// TEAM_ID below is used for Release builds only. Debug ignores it (Automatic mode).
APP_BUNDLE_ID = org.mifos.kmp.template
APP_NAME = Mifos - Money Toolkit
TEAM_ID = L432S2FZP5
