# ─────────────────────────────────────────────────────────────────────────────
# gradle/fork.properties.template
#
# Fork-specific deployment identity and store metadata — non-secret values only.
#
# HOW TO USE:
#   1. Copy:  cp gradle/fork.properties.template gradle/fork.properties
#   2. Fill in every value below with your actual values.
#   3. Run:   ./gradlew syncForkConfig
#      Propagates values to: xcconfig, local.properties (Fastlane bridge),
#      and ALL store metadata files (App Store, Play Store, Mac App Store).
#
# COMMITTED vs GITIGNORED:
#   gradle/fork.properties.template  — committed (this file — the schema)
#   gradle/fork.properties           — gitignored (your filled-in values)
#
# APP BUILD-TIME VALUES (appId, appDisplayName, projectName, iosTeamId, etc.)
# also live in gradle/libs.versions.toml — Gradle reads them at compile time.
# Keep both files consistent. syncForkConfig validates they match.
#
# CI SETUP: Set ENV vars directly — fork.properties is not needed on CI.
#           See each key for its ENV var. The 6 TOML values are always available
#           (they're committed). The Fastlane bridge (local.properties) is
#           written by syncForkConfig on CI before Fastlane runs.
#
# WHAT BELONGS HERE (non-secret identifiers):
#   Firebase App IDs, Apple Team ID, Match repo URL, org contact info,
#   store titles, descriptions, keywords, URLs, copyright, categories.
#
# WHAT DOES NOT BELONG HERE (real secrets):
#   API keys, passwords, keystores, .p8 files, service-account JSON.
#   Those go in secrets/ — see deployment/BOOTSTRAP.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── Apple Platform ────────────────────────────────────────────────────────────

# Apple Developer Team ID (10 alphanumeric characters).
# Find at: developer.apple.com → Account → Membership Details → Team ID
# Example: A1B2C3D4E5
# ENV: APPLE_TEAM_ID
apple.team.id=YOUR_TEAM_ID

# Fastlane Match git repo (SSH URL).
# Private GitHub/GitLab repo that stores encrypted certificates + profiles.
# Step 1: Create a private repo (e.g. acme/ios-provisioning).
# Step 2: Add secrets/match/match_ci_key.pub as a deploy key with write access.
# Step 3: Run: bundle exec fastlane match init --git_url <this-value>
# Guide: deployment/BOOTSTRAP.md → Fastlane Match setup
# ENV: MATCH_GIT_URL
apple.match.git.url=git@github.com:YOUR_ORG/ios-provisioning.git

# TestFlight external tester groups (comma-separated for multiple groups).
# Create at: App Store Connect → TestFlight → Builds → External Groups
# ENV: TESTFLIGHT_GROUPS
apple.tf.groups=beta-testers

# ── Firebase App Distribution ─────────────────────────────────────────────────
# App IDs are NOT secrets — safe to commit. They identify your Firebase app.
# Find at: Firebase Console → Project Settings → General → Your apps → App ID
# Format:  1:PROJECT_NUMBER:platform:HEX_STRING
# Example: 1:728434912738:android:3902eb3363b0938f1a1dbb

# Android prod flavor App ID — Firebase console → Android prod app
# ENV: FIREBASE_ANDROID_PROD_APP_ID
firebase.android.prod.app.id=1:000000000000:android:aaaaaaaaaaaaaaaa

# Android demo flavor App ID — Firebase console → Android demo app
# ENV: FIREBASE_ANDROID_DEMO_APP_ID
firebase.android.demo.app.id=1:000000000000:android:bbbbbbbbbbbbbbbb

# iOS App ID — Firebase console → iOS app
# ENV: FIREBASE_IOS_APP_ID
firebase.ios.app.id=1:000000000000:ios:cccccccccccccccc

# Firebase App Distribution tester group(s).
# Find at: Firebase Console → App Distribution → Testers & Groups tab
# Comma-separated for multiple groups.
# ENV: FIREBASE_GROUPS
firebase.groups=internal-testers

# ── Organization Identity ─────────────────────────────────────────────────────
# Used for: App Store review contact, TestFlight beta review info,
# store metadata (URLs, copyright), and review_information/ txt files.

# Organization display name (App Store / TestFlight review contact).
# ENV: ORGANIZATION_NAME
org.name=Your Organization Name

# Review contact email address.
# Apple will email this during App Store review — must be monitored.
# Also used as TestFlight beta feedback email.
# ENV: APPSTORE_REVIEW_EMAIL / BETA_FEEDBACK_EMAIL
org.email=appstore@example.com

# Review contact name. Shown in TestFlight beta review submission.
# ENV: APPSTORE_REVIEW_FIRST_NAME / TESTFLIGHT_FIRST_NAME
org.first.name=Jane
# ENV: APPSTORE_REVIEW_LAST_NAME / TESTFLIGHT_LAST_NAME
org.last.name=Smith

# Review contact phone (E.164 format — +country-code-number).
# Apple may call this number during review for high-priority apps.
# ENV: APPSTORE_REVIEW_PHONE / TESTFLIGHT_PHONE
org.phone=+12125551234

# App marketing URL shown in App Store / TestFlight listing.
# Must be publicly accessible at submission time.
# ENV: APP_MARKETING_URL
org.marketing.url=https://example.com

# Privacy policy URL. Required for App Store submission.
# Must be a publicly accessible, working URL.
# ENV: APP_PRIVACY_URL
org.privacy.url=https://example.com/privacy

# Support URL shown in store metadata. Typically your GitHub repo or docs site.
org.support.url=https://github.com/YOUR_ORG/YOUR_REPO

# ── Legal Documents ───────────────────────────────────────────────────────────
# Used by: bash legal/generate.sh → legal/output/privacy-policy.md + terms.md
#
# After filling these in, run:
#   bash legal/generate.sh
#   git add legal/output/ && git commit -m "docs(legal): generate privacy policy + terms"
#
# Then set org.privacy.url (above) to the raw GitHub URL of the generated file:
#   https://raw.githubusercontent.com/YOUR_ORG/YOUR_REPO/main/legal/output/privacy-policy.md
# Run ./gradlew syncForkConfig to propagate to all store metadata.

# Legal entity name (may differ from org.name / app display name).
# Appears in "operated by <COMPANY_NAME>" in legal documents.
legal.company.name=Your Legal Entity Name

# Jurisdiction governing the legal documents (e.g. "India", "California, USA").
# Appears in the governing law clause of both documents.
legal.jurisdiction=Your Jurisdiction

# Effective date for legal documents (human-readable, e.g. "June 1, 2026").
# Update this whenever the documents change.
legal.effective.date=January 1, 2026

# Privacy contact email. Shown in the privacy policy as the point of contact
# for data-related questions. May be the same as org.email.
legal.contact.email=privacy@example.com

# ── Web Platform ──────────────────────────────────────────────────────────────

# Cloudflare Pages project name (created in Cloudflare Dashboard → Pages).
# Also set as a GitHub Actions variable (not a secret):
#   Repo → Settings → Secrets and variables → Variables → CLOUDFLARE_PAGES_PROJECT_NAME
# ENV: CLOUDFLARE_PAGES_PROJECT_NAME
web.cloudflare.project=your-app-web

# ── Store Metadata — Shared across iOS, macOS, and Android ───────────────────
# syncForkConfig writes these to all platform metadata directories automatically.

# App name on the store listing page.
# iOS / macOS App Store: max 30 characters (shown below icon on device).
# Android Play Store: max 50 characters.
store.title=Your App Name

# Tagline / subtitle shown below the app name (iOS and macOS App Store only).
# Max 30 characters. Make it descriptive and keyword-rich.
store.subtitle=Your App Tagline Here

# Short promotional text shown in TestFlight above the description.
# Max 170 characters. Can be updated anytime without a new app version.
store.promotional.text=Your app's one-line promotional pitch for TestFlight.

# What's new text shown in the App Store and Google Play update dialog.
# Shown to existing users when they see an update notification.
store.release.notes=Bug fixes and performance improvements.

# Changelog shown in Play Store (Android only). Can be same as release.notes
# or more detailed. Written to changelogs/default.txt.
store.android.changelog=Bug fixes and performance improvements.

# Copyright line shown in App Store listing.
# Convention: Copyright © YEAR Your Organization Name
store.copyright=Copyright © 2025 Your Organization Name

# Short note for App Store review team explaining how to access the app.
# Max 4000 characters. Explain if no login is required, demo credentials, etc.
store.review.notes=No login required. All features are accessible without an account.

# ── Store Metadata — Android (Google Play Store) ─────────────────────────────

# Short description shown in Play Store search results (max 80 characters).
# This is the first thing users see — make it compelling and keyword-rich.
store.android.short.description=Your short Play Store description here. Max 80 chars.

# Play Store primary category.
# Common values: Finance, Productivity, Tools, Education, Business
# Full list: https://support.google.com/googleplay/android-developer/answer/113475
store.android.category=Finance

# ── Store Metadata — iOS App Store ───────────────────────────────────────────

# Keywords used by App Store search algorithm (max 100 characters total).
# Comma-separated. Do NOT repeat words from app name or subtitle —
# they're already indexed. Focus on related terms users search for.
store.ios.keywords=keyword1,keyword2,keyword3,keyword4

# iOS App Store primary category.
# Common values: Finance, Productivity, Utilities, Business, Education
# Full list: https://developer.apple.com/app-store/categories/
store.ios.category=Finance

# ── Store Metadata — macOS App Store ─────────────────────────────────────────

# Keywords for Mac App Store search (comma-separated, same rules as iOS).
store.macos.keywords=keyword1,keyword2,keyword3,keyword4

# Mac App Store primary category.
# Common values: Finance, Productivity, Utilities, Business
store.macos.category=Productivity
