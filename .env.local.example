# =============================================================================
# .env.local.example — copy to .env.local and fill in fork-specific values.
#
# This file is committed; .env.local is gitignored. Forks duplicate this file
# locally, then their build / Koin DI reads the values at runtime.
#
# NOTHING IN HERE IS A SECRET. Real keys ONLY go in .env.local (gitignored).
# =============================================================================

# -----------------------------------------------------------------------------
# FRED (Federal Reserve Economic Data) — interest-rate API.
#
# Used by the Banking Utility Toolkit's "B7 Interest Rate Tracker" screen.
# Free tier: 120 requests/minute, no usage caps for non-commercial use.
#
# Sign-up:  https://fred.stlouisfed.org/docs/api/api_key.html
# Wire-up:  read this value into FredApiConfig.apiKey in your Koin module.
#
# Leave blank to disable the FRED-backed screens — the toolkit will surface
# an explicit "FRED key not configured" empty state rather than crashing.
# -----------------------------------------------------------------------------
FRED_API_KEY=e092e4eff5b9d82b5ff2af620966d7a9

# -----------------------------------------------------------------------------
# World Bank Open Data — country macro indicators API.
#
# NO key required — World Bank Open Data is fully open. Documented here for
# completeness; the toolkit's "B8 Country Macro Snapshot" screen works
# out-of-the-box without any local configuration.
# -----------------------------------------------------------------------------
# WORLD_BANK_BASE_URL=https://api.worldbank.org/   # override only if mirroring
