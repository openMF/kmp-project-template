// kmp-product-flavors — flavor: prod  build-type: debug

KMPF_VARIANT = prodDebug
KMPF_FLAVOR_NAME = prod
KMPF_BUILD_TYPE_NAME = debug
KMPF_BASE_URL = https://api.openmf.org
KMPF_BUNDLE_ID = cmp-shared.prod.debug
KMPF_DEMO_USERNAME =
KMPF_DEMO_PASSWORD =
KMPF_ENABLE_LOGGING = YES
KMPF_IS_DEBUG = YES
KMPF_IS_DEMO = NO
KMPF_IS_DEMO_BUILD = NO
KMPF_LOG_TAG = KMPTemplate-DEBUG
KMPF_SHOW_DEBUG_OVERLAY = YES

