// kmp-product-flavors — flavor: prod  build-type: staging

KMPF_VARIANT = prodStaging
KMPF_FLAVOR_NAME = prod
KMPF_BUILD_TYPE_NAME = staging
KMPF_BASE_URL = https://api.openmf.org
KMPF_BUNDLE_ID = cmp-shared.prod.staging
KMPF_DEMO_USERNAME =
KMPF_DEMO_PASSWORD =
KMPF_ENABLE_LOGGING = YES
KMPF_IS_DEBUG = NO
KMPF_IS_DEMO = NO
KMPF_IS_DEMO_BUILD = NO
KMPF_LOG_TAG = KMPTemplate-STAGING
KMPF_SHOW_DEBUG_OVERLAY = NO

